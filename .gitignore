# Environnements
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/

# PyCharm
.idea/

# Données : jamais commitées, reconstruites via sources.yaml + fetch-data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# ... sauf le manifeste de collecte, qui EST la traçabilité
!data/raw/_manifest.json

# Documents de travail locaux : ne font pas partie du livrable et ne se régénèrent
# pas depuis sources.yaml. Gardés sur le poste, hors du dépôt.
audit/
exercices/

# Matériel de travail, hors livrable : rapports d'audit, pages web enregistrées,
# PDF de contexte (droit d'auteur). Les faits qu'on en tire sont fichés, sourcés et
# versionnés dans docs/SOURCES_LOCALES.md — pas les originaux.
audit/

# Exercices pédagogiques dérivés du dépôt : hors livrable, et leurs chiffres sont
# ceux d'un audit daté — aucun test ne les verrouille, ils dériveraient en silence.
exercices/

# Divers
.DS_Store
*.log
